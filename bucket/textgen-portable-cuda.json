{
    "version": "4.8",
    "description": "Open-source desktop app for local LLMs with text, vision and tool-calling support (portable, latest CUDA build)",
    "homepage": "https://github.com/oobabooga/textgen",
    "license": "AGPL-3.0-only",
    "url": "https://github.com/oobabooga/textgen/releases/download/v4.8/textgen-portable-4.8-windows-cuda13.1.zip",
    "hash": "20185ef73266f0e0215626df24f46b2be0971518e832b1648348fc334668e855",
    "persist": "user_data",
    "bin": [
        [
            "textgen.bat",
            "textgen-cuda"
        ]
    ],
    "shortcuts": [
        [
            "textgen.bat",
            "textgen (CUDA)"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/oobabooga/textgen/releases/latest",
        "regex": "textgen-portable-([\\d.]+)-windows-(?<cudatag>cuda[\\d.]+)\\.zip",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://github.com/oobabooga/textgen/releases/download/v$version/textgen-portable-$version-windows-$matchCudatag.zip",
        "hash": {
            "url": "https://api.github.com/repos/oobabooga/textgen/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name=='textgen-portable-$version-windows-$matchCudatag.zip')].digest"
        }
    },
    "notes": [
        "This manifest always tracks the newest CUDA build (currently CUDA 13.1). For the legacy CUDA build install 'textgen-portable-cuda-legacy'.",
        "Models, characters and settings are stored in the persisted 'user_data' directory.",
        "Launch via the 'textgen (CUDA)' Start Menu shortcut or by running 'textgen-cuda' in a terminal."
    ]
}
